# AWS Region used to call Amazon Bedrock. Supported source Regions for the
# US cross-region inference profiles used by this workshop are:
#   us-east-1, us-east-2, us-west-2
# Requests may be routed to any of those three destination Regions, so model
# access must be enabled for both Claude Haiku 4.5 and Claude Sonnet 4.6 in
# all three (see the README "Models used" section for details).
AWS_REGION=us-east-1

# Tavily API key for the agentic-search labs. Free tier is sufficient.
# Get one at https://app.tavily.com/home
TAVILY_API_KEY=<paste your api key here>

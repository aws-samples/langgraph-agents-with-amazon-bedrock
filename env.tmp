# AWS Region used to call Amazon Bedrock. This workshop uses US geographic
# cross-region inference (CRIS) profiles for Amazon Nova Lite (fast default) and
# Amazon Nova Pro (reasoning), which keep inference within US Regions.
# Default source Region: us-east-1 (N. Virginia). Bedrock model access for both Nova
# Lite and Nova Pro must be enabled in the console for the US CRIS destination
# Regions (see the README "Models used" section).
AWS_REGION=us-east-1

# Tavily API key for the agentic-search labs. Free tier is sufficient.
# Get one at https://app.tavily.com/home
TAVILY_API_KEY=<paste your api key here>
